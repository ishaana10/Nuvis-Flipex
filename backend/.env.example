APP_ENV=local
APP_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
DB_HOST=db
DB_NAME=flipbook
DB_USER=flipbook
DB_PASS=secret
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@flipbook.local
# Allowed CORS Origin for API requests
CORS_ORIGIN=http://localhost:5173

# PDF Rendering Engine ('auto', 'ghostscript', 'imagick', or 'pdftoppm')
# A2 Hosting / cPanel: Ghostscript (/usr/bin/gs) and PHP imagick extension
PDF_DRIVER=auto

# Path to Ghostscript binary (Default on A2 Hosting / Linux: /usr/bin/gs)
GS_BIN=/usr/bin/gs

# Path to Poppler pdftoppm binary (Optional: for servers with poppler-utils installed)
# PDFTOPPM_BIN=/usr/bin/pdftoppm
