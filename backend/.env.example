APP_ENV=local
APP_URL=http://localhost:5173
# Cryptographic secrets (leave blank before running `php bin/install.php`; installer generates 256-bit random keys and rejects placeholders)
JWT_SECRET=
STORAGE_SIGNING_SECRET=
PREVIEW_TOKEN_SECRET=
UNLOCK_TOKEN_SECRET=
# Shared secret for the internal queue-worker endpoint (X-Worker-Secret header). Must differ from JWT_SECRET.
WORKER_SECRET=
DB_HOST=db
DB_NAME=flipbook
DB_USER=flipbook
DB_PASS=secret
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@flipbook.local
# Allowed CORS origin(s) for API requests, comma-separated (e.g. https://a.com,https://b.com).
# Leave empty in production when the SPA and API share one origin; a wildcard (*) is ignored.
CORS_ORIGIN=http://localhost:5173

# Optional: override the release number shown by the API (defaults to the repo-root VERSION file)
# APP_VERSION=

# PDF Rendering Engine ('auto', 'ghostscript', 'imagick', or 'pdftoppm')
# A2 Hosting / cPanel: Ghostscript (/usr/bin/gs) and PHP imagick extension
PDF_DRIVER=auto

# Path to Ghostscript binary (Default on A2 Hosting / Linux: /usr/bin/gs)
GS_BIN=/usr/bin/gs

# Path to Poppler pdftoppm binary (Optional: for servers with poppler-utils installed)
# PDFTOPPM_BIN=/usr/bin/pdftoppm
